# OKX 模拟盘 API 凭据（在 OKX 官网「模拟交易」环境下创建 API Key）
# 复制本文件为 .env 后填写，.env 已被 .gitignore 排除，不会进版本库。
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# 交易环境：1 = 模拟盘（默认，安全），0 = 实盘（需要额外确认）
OKX_FLAG=1

# 可选：覆盖配置文件中的日志级别（DEBUG/INFO/WARNING/ERROR）
# OKXQUANT_LOG_LEVEL=INFO

# 可选：数据存储位置。文件路径 = SQLite（默认 data/quant.db）；
# postgresql:// URL = Postgres（云端部署推荐，连接串末尾带上 ?sslmode=require）
# OKX_DB_PATH=postgresql://user:pass@host/db?sslmode=require

# 可选：指定配置文件路径，默认 config/default.toml
# OKXQUANT_CONFIG=config/default.toml

# ---------------------------------------------------------------------------
# 远程部署目标（仅 scripts/deploy_remote.sh 使用，程序运行时不读取这些变量）
# 用于把代码发布到能直连 OKX 的服务器上做真实链路验证
# ---------------------------------------------------------------------------
# DEPLOY_SSH_HOST=user@your-server
# DEPLOY_SSH_PORT=22
# DEPLOY_SSH_PASSWORD=
