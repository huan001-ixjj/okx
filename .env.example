# OKX 模拟盘 API 凭据（在 OKX 官网「模拟交易」环境下创建 API Key）
# 复制本文件为 .env 后填写，.env 已被 .gitignore 排除，不会进版本库。
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# 交易环境：1 = 模拟盘（默认，安全），0 = 实盘（需要额外确认）
OKX_FLAG=1

# 可选：覆盖配置文件中的日志级别（DEBUG/INFO/WARNING/ERROR）
# OKXQUANT_LOG_LEVEL=INFO

# 可选：指定配置文件路径，默认 config/default.toml
# OKXQUANT_CONFIG=config/default.toml

# ---------------------------------------------------------------------------
# 网络出口（开发环境专用，公网服务器请全部留空，走直连）
# ---------------------------------------------------------------------------
# 显式代理，优先级最高；例如 socks5h://127.0.0.1:7890
# 注意必须是 socks5h（h 表示由代理解析域名），否则绕不开本地 DNS 污染
# OKX_PROXY=

# SSH 动态转发隧道：在本地开一个 SOCKS5 端口，联网命令会自动拉起
# OKX_TUNNEL_ENABLED=true
# OKX_TUNNEL_HOST=user@your-ssh-host
# OKX_TUNNEL_PORT=1080
# OKX_TUNNEL_SSH_PORT=22
# 密码只用于建立隧道，不会出现在命令行参数与日志中
# OKX_TUNNEL_PASSWORD=
